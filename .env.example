# Copie para .env. Tudo aqui é FICTÍCIO e serve só para rodar o projeto na sua máquina.
# Em produção a aplicação se recusa a subir com estes valores.

AMBIENTE=desenvolvimento
LOG_NIVEL=INFO

# Sem Docker, o padrão é um arquivo SQLite. Com o docker compose, o Postgres do compose.
DATABASE_URL=sqlite:///./limite_garantido.db
# DATABASE_URL=postgresql+psycopg://lg:lg@localhost:5432/lg

# Token da API administrativa (/v1/admin). Sem ele, ela responde 404.
ADMIN_TOKEN=token-de-exemplo-troque-antes-de-usar-0000

# Sandbox: endpoints que simulam queda de ativo e passagem de dias.
SANDBOX_HABILITADO=true

# Página /demo e o parceiro de exemplo dela.
DEMO_HABILITADO=true
DEMO_API_KEY=lgk_exemplo000000_chave-ficticia-so-para-a-demonstracao
DEMO_WEBHOOK_SEGREDO=whsec_exemplo-segredo-ficticio-so-para-a-demonstracao
DEMO_WEBHOOK_URL=http://localhost:8000/demo/webhooks

# Em desenvolvimento o worker entrega para localhost. Em produção isso é proibido (SSRF).
WEBHOOK_PERMITIR_REDE_INTERNA=true
# Retentativas rápidas para dar para ver na demo. O padrão de produção é 30s.
WEBHOOK_BACKOFF_BASE_SEGUNDOS=2
WORKER_INTERVALO_SEGUNDOS=0.5
